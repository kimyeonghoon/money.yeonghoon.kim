# 프로젝트 설정
PROJECT_NAME=FastAPI Backend
VERSION=1.0.0
API_V1_STR=/api/v1

# 보안 설정 (프로덕션에서는 반드시 변경하세요!)
# SECRET_KEY 생성: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-please-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 데이터베이스 설정
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=appuser
MYSQL_PASSWORD=your_strong_password_here
MYSQL_DATABASE=appdb

# MySQL Root 비밀번호 (Docker Compose에서 사용)
MYSQL_ROOT_PASSWORD=your_root_password_here

# CORS 설정 (쉼표로 구분된 URL 목록)
BACKEND_CORS_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19001,http://localhost:19002

# Sentry 에러 트래킹 (선택 사항)
# Sentry DSN을 입력하면 에러 트래킹이 활성화됩니다
# https://sentry.io 에서 프로젝트 생성 후 DSN 획득
SENTRY_DSN=
ENVIRONMENT=development

# Telegram 2FA 설정
# 로그인 시 Telegram으로 인증 코드를 전송합니다
# Bot Token 발급: @BotFather에서 /newbot 명령어 사용
# Chat ID 확인: @userinfobot에서 자신의 Chat ID 확인
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id-from-userinfobot