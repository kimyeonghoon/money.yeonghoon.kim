# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MySQL 8.0 설정 - 한국 환경 최적화
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 이 파일은 MySQL 서버를 한국 환경에 맞게 설정합니다.
#
# 주요 설정:
#   - 문자셋: utf8mb4 (이모지, 한글 등 4바이트 문자 지원)
#   - Collation: utf8mb4_unicode_ci (유니코드 정렬 규칙)
#   - 타임존: Asia/Seoul
#   - 성능 최적화
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 기본 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 데이터 디렉토리
datadir = /var/lib/mysql

# 소켓 파일
socket = /var/run/mysqld/mysqld.sock

# PID 파일
pid-file = /var/run/mysqld/mysqld.pid

# MySQL 서버 ID (복제 사용 시 고유해야 함)
server-id = 1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 문자셋 및 Collation (한국어 지원)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 기본 문자셋: utf8mb4 (4바이트 UTF-8, 이모지 지원)
character-set-server = utf8mb4

# 기본 Collation: utf8mb4_unicode_ci (대소문자 구분 안 함, 다국어 정렬)
collation-server = utf8mb4_unicode_ci

# 클라이언트 연결 시 문자셋
init-connect = 'SET NAMES utf8mb4'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 타임존 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 기본 타임존: 한국 표준시 (KST, UTC+9)
default-time-zone = '+09:00'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 네트워크 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 바인드 주소: 모든 네트워크 인터페이스에서 연결 허용
bind-address = 0.0.0.0

# 포트
port = 3306

# 최대 연결 수
max_connections = 200

# 최대 허용 패킷 크기 (64MB)
max_allowed_packet = 64M

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 성능 최적화
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 현재 설정: 시스템 메모리 2GB 기준 (개발 환경 / 소규모 프로덕션)
#
# 메모리 사용량 분석:
#   - 고정 메모리: ~800 MB (InnoDB 버퍼 풀, 로그, 캐시 등)
#   - 연결당 메모리: ~10 MB (최대 200개 연결 시 2GB)
#   - 일반적인 사용: ~1-1.5 GB (10-20개 활성 연결)
#
# 다른 메모리 환경을 위한 권장 설정:
#
#   【1GB RAM - 최소 사양】
#   innodb_buffer_pool_size = 256M
#   max_connections = 50
#   tmp_table_size = 32M
#   max_heap_table_size = 32M
#   sort_buffer_size = 1M
#   read_buffer_size = 1M
#   read_rnd_buffer_size = 2M
#   join_buffer_size = 1M
#
#   【4GB RAM - 중규모 프로덕션】
#   innodb_buffer_pool_size = 2G
#   max_connections = 300
#   tmp_table_size = 128M
#   max_heap_table_size = 128M
#   sort_buffer_size = 4M
#   read_buffer_size = 4M
#   read_rnd_buffer_size = 8M
#   join_buffer_size = 4M
#
#   【8GB+ RAM - 대규모 프로덕션】
#   innodb_buffer_pool_size = 4G
#   max_connections = 500
#   tmp_table_size = 256M
#   max_heap_table_size = 256M
#   sort_buffer_size = 8M
#   read_buffer_size = 8M
#   read_rnd_buffer_size = 16M
#   join_buffer_size = 8M
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# InnoDB 버퍼 풀 크기 (전체 메모리의 50-70% 권장, 여기서는 512MB)
innodb_buffer_pool_size = 512M

# InnoDB 로그 파일 크기
innodb_log_file_size = 128M

# InnoDB 플러시 로그 설정 (1: 가장 안전, 2: 성능 우선)
innodb_flush_log_at_trx_commit = 1

# InnoDB 플러시 방법
innodb_flush_method = O_DIRECT

# 테이블 오픈 캐시
table_open_cache = 2000

# 테이블 정의 캐시
table_definition_cache = 1400

# 쿼리 캐시 (MySQL 8.0에서는 제거됨)
# query_cache_type = 0
# query_cache_size = 0

# 임시 테이블 크기
tmp_table_size = 64M
max_heap_table_size = 64M

# 정렬 버퍼 크기
sort_buffer_size = 2M

# 읽기 버퍼 크기
read_buffer_size = 2M
read_rnd_buffer_size = 4M

# 조인 버퍼 크기
join_buffer_size = 2M

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 로깅 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 일반 쿼리 로그 (개발 환경에서만 활성화 권장)
general_log = 0
general_log_file = /var/log/mysql/general.log

# 슬로우 쿼리 로그 (2초 이상 걸리는 쿼리 기록)
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# 인덱스를 사용하지 않는 쿼리 로깅
log_queries_not_using_indexes = 0

# 에러 로그
log_error = /var/log/mysql/error.log

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 바이너리 로그 (복제 및 백업용)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 바이너리 로그 활성화 (프로덕션에서 권장)
# log_bin = /var/log/mysql/mysql-bin.log
# binlog_format = ROW
# expire_logs_days = 7
# max_binlog_size = 100M

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SQL 모드
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 엄격한 SQL 모드 (데이터 무결성 보장)
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 보안 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 로컬 파일 로드 비활성화 (보안)
local_infile = 0

# 심볼릭 링크 비활성화 (보안)
symbolic-links = 0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 기타 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 대소문자 구분 (0: 구분, 1: 구분 안 함, 2: 테이블만 소문자)
lower_case_table_names = 0

# 쿼리 타임아웃 (30초)
max_execution_time = 30000

# 트랜잭션 격리 수준
transaction_isolation = READ-COMMITTED

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# [mysqldump] 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[mysqldump]
quick
quote-names
max_allowed_packet = 64M
default-character-set = utf8mb4

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# [isamchk] 설정 (MyISAM 테이블 복구 도구)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[isamchk]
key_buffer_size = 16M
