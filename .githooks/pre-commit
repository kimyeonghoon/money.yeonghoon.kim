#!/bin/bash

# Git Pre-commit Hook - 민감 정보 커밋 방지
#
# 설치 방법:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-commit

echo "🔍 민감 정보 검사 중..."

# 색상 코드
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# 커밋하려는 파일 목록
FILES=$(git diff --cached --name-only --diff-filter=ACM)

# 검사할 민감 정보 패턴
PATTERNS=(
    # 환경 변수 파일
    "\.env$"
    "\.env\.local$"
    "\.env\.production$"
    "\.env\.development$"

    # AWS 키
    "AKIA[0-9A-Z]{16}"
    "aws_access_key_id"
    "aws_secret_access_key"

    # 비밀번호 패턴
    "password\s*=\s*['\"][^'\"]{8,}['\"]"
    "PASSWORD\s*=\s*['\"][^'\"]{8,}['\"]"
    "pwd\s*=\s*['\"][^'\"]{8,}['\"]"

    # API 키
    "api_key\s*=\s*['\"][^'\"]{20,}['\"]"
    "api[_-]?key['\"]?\s*[:=]\s*['\"][^'\"]{20,}['\"]"
    "apikey"

    # JWT / 토큰
    "bearer\s+[a-zA-Z0-9\-._~+/]+=*"
    "token\s*=\s*['\"][^'\"]{30,}['\"]"

    # 데이터베이스 URL (실제 비밀번호 포함)
    "mysql://.*:.*@"
    "postgresql://.*:.*@"
    "mongodb://.*:.*@"

    # Private Key
    "-----BEGIN RSA PRIVATE KEY-----"
    "-----BEGIN PRIVATE KEY-----"
    "-----BEGIN OPENSSH PRIVATE KEY-----"

    # 기타
    "secret\s*=\s*['\"][^'\"]{8,}['\"]"
    "SECRET\s*=\s*['\"][^'\"]{8,}['\"]"
)

# 경고 플래그
FOUND_SECRETS=false

# 각 파일 검사
for FILE in $FILES; do
    # .env.example은 허용
    if [[ "$FILE" == *".env.example"* ]]; then
        continue
    fi

    # 각 패턴 검사
    for PATTERN in "${PATTERNS[@]}"; do
        # 파일명 패턴 검사
        if [[ "$FILE" =~ $PATTERN ]]; then
            echo -e "${RED}❌ 금지된 파일: $FILE${NC}"
            echo -e "${YELLOW}   환경 변수 파일은 커밋할 수 없습니다.${NC}"
            FOUND_SECRETS=true
            continue 2
        fi

        # 파일 내용 검사
        if git diff --cached "$FILE" | grep -iE "$PATTERN" > /dev/null; then
            echo -e "${RED}❌ 민감 정보 발견: $FILE${NC}"
            echo -e "${YELLOW}   패턴: $PATTERN${NC}"

            # 해당 라인 표시 (최대 3줄)
            git diff --cached "$FILE" | grep -iE "$PATTERN" | head -3 | while read line; do
                echo -e "${YELLOW}   → $line${NC}"
            done

            FOUND_SECRETS=true
        fi
    done
done

# 결과 처리
if [ "$FOUND_SECRETS" = true ]; then
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}⚠️  민감 정보가 감지되었습니다!${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "해결 방법:"
    echo "1. 민감 정보를 제거하고 환경 변수로 대체"
    echo "2. .env 파일은 .env.example로 예시만 제공"
    echo "3. .gitignore에 추가"
    echo ""
    echo "강제로 커밋하려면 (권장하지 않음):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ 민감 정보 검사 통과${NC}"
exit 0
